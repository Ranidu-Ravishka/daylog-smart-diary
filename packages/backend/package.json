{
  "name": "@repo/backend",
  "private": true,
  "version": "0.0.0",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./convex": "./convex/_generated/api.js",
    "./convex/*": "./convex/_generated/*"
  },
  "scripts": {
    "start": "convex dev",
    "dev": "convex dev",
    "predev": "convex dev --until-success",
    "logs": "convex logs",
    "check-types": "tsc -p convex --noEmit",
    "lint": "tsc -p convex && eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage:backend": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/user-settings": "workspace:*",
    "@aws-sdk/client-kms": "^3.500.0",
    "@sentry/node": "^10.48.0",
    "convex": "^1.29.3",
    "svix": "^1.58.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}