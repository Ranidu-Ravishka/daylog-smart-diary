{
  "name": "daylog-test",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:admin": "turbo run build --filter=admin",
    "dev": "turbo dev",
    "dev:backend": "pnpm dev:convex",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:convex": "turbo run dev --filter=@packages/backend",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=web",
    "lint:mobile": "turbo run lint --filter=mobile",
    "lint:admin": "turbo run lint --filter=admin",
    "format": "prettier --write  \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run check-types",
    "test": "turbo run test",
    "test:web": "pnpm --filter web test",
    "test:backend": "pnpm --filter @repo/backend test:run",
    "test:admin": "pnpm --filter admin test",
    "test:mobile": "pnpm --filter mobile test",
    "test:e2e:web": "pnpm --filter web test:e2e",
    "check:bundle-budgets": "node scripts/check-bundle-budgets.mjs",
    "test:coverage": "pnpm test:coverage:backend",
    "test:coverage:backend": "pnpm --filter @repo/backend test:coverage:backend",
    "check:baseline-browser-mapping": "node scripts/check-baseline-browser-mapping-freshness.mjs",
    "verify:branch-protection": "node scripts/verify-branch-protection.mjs",
    "ops:rotate-sensitive-data-keyring": "node scripts/rotate-sensitive-data-keyring.mjs",
    "ops:run-sensitive-data-migration": "node scripts/run-sensitive-data-migration.mjs",
    "ops:run-integration-token-hardening": "node scripts/run-integration-token-hardening.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.13"
  }
}
