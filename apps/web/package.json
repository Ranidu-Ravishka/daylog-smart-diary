{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next typegen && tsc --noEmit",
    "check:boundaries": "node ./scripts/check-backend-boundary-imports.mjs",
    "test": "pnpm test:oauth-abuse",
    "test:oauth-abuse": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@repo/backend": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/user-settings": "workspace:*",
    "@sentry/nextjs": "^10.47.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.29.3",
    "import-in-the-middle": "^3.0.0",
    "lucide-react": "^0.577.0",
    "next": "^16.0.1",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "require-in-the-middle": "^8.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "baseline-browser-mapping": "^2.10.20",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.1.17",
    "typescript": "5.9.2",
    "vitest": "^4.1.2"
  }
}
