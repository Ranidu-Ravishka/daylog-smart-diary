{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_APP_ENV",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "SPOTIFY_CLIENT_ID",
    "SPOTIFY_CLIENT_SECRET",
    "NEXT_RUNTIME",
    "SENTRY_DSN",
    "SENTRY_TRACES_SAMPLE_RATE",
    "SENTRY_RELEASE",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE",
    "NEXT_PUBLIC_SENTRY_RELEASE",
    "EXPO_PUBLIC_SENTRY_RELEASE",
    "NEXT_PUBLIC_INFO_EVENT_SAMPLE_RATE",
    "EXPO_PUBLIC_INFO_EVENT_SAMPLE_RATE",
    "RETENTION_INFO_EVENTS_DAYS",
    "OBSERVABILITY_INGEST_JWT_SECRETS",
    "OBSERVABILITY_INGEST_ALLOWED_ORIGINS",
    "CONVEX_HTTP_SITE_URL",
    "NEXT_PUBLIC_CONVEX_HTTP_SITE_URL",
    "VERCEL_GIT_COMMIT_SHA",
    "EAS_BUILD_GIT_COMMIT_HASH",
    "PLAYWRIGHT_BASE_URL",
    "PLAYWRIGHT_WEB_PORT",
    "PLAYWRIGHT_WEB_HOST",
    "PLAYWRIGHT_SKIP_WEBSERVER",
    "CLERK_SECRET_KEY",
    "MOBILE_DIST_PATH",
    "MOBILE_WEB_ENTRY_MAX_BYTES",
    "SKIP_MOBILE_BUNDLE_BUDGET",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
